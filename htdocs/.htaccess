# ── DASA C&C — .htaccess servidor local ──────────────────────────────────

# Sin redirect HTTPS (servidor interno)
RewriteEngine On

# Bloquear listado de directorios
Options -Indexes

# Bloquear acceso a logs
<IfModule mod_rewrite.c>
    RewriteRule ^logs/ - [F,L]

    # La app nueva (v2) es la principal: "/" lleva a /v2/.
    # 302 (no 301) a propósito: el navegador no lo cachea y se puede volver atrás
    # sacando esta línea.
    RewriteRule ^$ v2/ [R=302,L]

    # La app anterior se sirve en /anterior/ (es el mismo index.html de la raíz;
    # usa rutas absolutas /*.php, así que anda igual desde cualquier URL).
    # /index.html sigue funcionando para favoritos viejos.
    RewriteRule ^anterior$ anterior/ [R=302,L]
    RewriteRule ^anterior/$ index.html [L]
</IfModule>

# Headers de seguridad
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://unpkg.com https://cdnjs.cloudflare.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://dasaargentina.com data: https:; connect-src 'self' https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://www.googleapis.com https://securetoken.googleapis.com https://panel.rapiwha.com https://*.dasaargentina.com http://192.168.0.245 http://localhost; font-src 'self' data:;"
</IfModule>

# Proteger config.php
<FilesMatch "^config\.php$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Caché
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
