# Carpeta de material subido — NUNCA ejecutar scripts acá
php_flag engine off
RemoveHandler .php .phtml .phar .php3 .php4 .php5 .php7 .pht
RemoveType .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|php[0-9]|pht|cgi|pl|py|sh|exe|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
